{
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    }
  ],
  "extends": [
    "schedule:earlyMondays"
  ],
  "minimumReleaseAge": "14 days",
  "internalChecksAsSuccess": true,
  "dependencyDashboard": true
}
